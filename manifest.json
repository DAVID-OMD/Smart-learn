{
  "id": "/Smart-learn/index.html",
  "name": "SmartLearn",
  "short_name": "SmartLearn",
  "description": "Secondary school learning: video lessons plus quizzes. Works offline.",
  "lang": "en",
  "dir": "ltr",
  "categories": ["education"],
  "iarc_rating_id": "REPLACE_WITH_IARC_ID",
  "prefer_related_applications": false,
  "related_applications": [],
  "start_url": "./index.html",
  "scope": "./",
  "scope_extensions": [],
  "display": "standalone",
  "display_override": ["tabbed", "window-controls-overlay"],
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#1e40af",
  "launch_handler": { "client_mode": "focus-existing" },
  "edge_side_panel": { "preferred_width": 480 },
  "note_taking": { "new_note_url": "./admin.html" },
  "protocol_handlers": [
    { "protocol": "web+smartlearn", "url": "./lessons.html?highlight=%s" }
  ],
  "share_target": {
    "action": "./lessons.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "file_handlers": [
    { "action": "./admin.html", "accept": { "application/json": [".json"] } }
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/lessons-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "SmartLearn home page preview"
    },
    {
      "src": "screenshots/home-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "SmartLearn on mobile"
    }
  ],
  "shortcuts": [
    {
      "name": "Watch Lessons",
      "url": "./lessons.html",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Take Quizzes",
      "url": "./subjects.html",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "widgets": [
    {
      "name": "SmartLearn Today",
      "description": "Study suggestion and progress at a glance.",
      "tag": "smartlearn-today",
      "start_url": "./widget.html",
      "screenshots": [
        { "src": "screenshots/home-mobile.png", "sizes": "390x844" }
      ],
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }],
      "auth": false,
      "update": 3600
    }
  ]
}
